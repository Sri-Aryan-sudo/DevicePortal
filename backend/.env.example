# ── Database ──────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=device-inventory
DB_USER=postgres
DB_PASSWORD=CHANGE_ME

# ── Server ────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── JWT ───────────────────────────────────────────
# Generate a random secret:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=8h

# ── CORS ──────────────────────────────────────────
# Comma-separated origins allowed to call the API
CORS_ORIGIN=http://localhost:3000

# ── Bcrypt ────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── Backups (optional) ────────────────────────────
# Defaults to <project root>/backups, e.g. /opt/DevicePortal/backups
# BACKUP_DIR=/opt/DevicePortal/backups
# Files older than this are deleted (the newest 7 of each kind are always kept)
# BACKUP_RETENTION_DAYS=30
